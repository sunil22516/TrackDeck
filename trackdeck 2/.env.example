# Copy to .env. All settings are prefixed TRACKDECK_
TRACKDECK_ENVIRONMENT=development
TRACKDECK_DATABASE_URL=sqlite+aiosqlite:///./trackdeck.db
# Production (paste Neon's string as-is; it is converted for asyncpg automatically):
# TRACKDECK_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
TRACKDECK_ENABLE_MOCK_DESTINATION=true       # false in production
TRACKDECK_MUSICBRAINZ_CONTACT=you@example.com  # enables the free open catalog
TRACKDECK_CORS_ORIGINS=["http://localhost:3000"]
# TRACKDECK_TRUST_PROXY_HEADERS=true          # behind Render/any proxy
# TRACKDECK_MAX_TRACKS_PER_PLAYLIST=500
# TRACKDECK_UPLOAD_LIMIT_PER_HOUR=10
# TRACKDECK_RETENTION_HOURS=24
